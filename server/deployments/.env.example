# StuHelper 部署环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# PostgreSQL 配置
POSTGRES_USER=stuhelper
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=stuhelper

# PostgreSQL 连接配置（用于应用程序）
DATABASE_URL=postgres://stuhelper:change_me_in_production@postgres:5432/stuhelper?sslmode=disable

# PostgreSQL 连接池配置
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30
DB_MAX_CONN_IDLE_TIME=5

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # 如果需要密码，取消注释并设置

# ==================== 应用配置 ====================
# 应用运行环境: development, production
APP_ENV=development

# 应用端口
APP_PORT=8080

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 日志格式: json, console
LOG_FORMAT=json

# 日志输出: stdout, stderr
LOG_OUTPUT=stdout

# 日志采样配置（高流量场景下减少日志量）
LOG_SAMPLING_ENABLED=false
LOG_SAMPLING_INITIAL=100
LOG_SAMPLING_AFTER=100

# 文件日志配置
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_SIZE=100
LOG_FILE_MAX_BACKUPS=3
LOG_FILE_MAX_AGE=7
LOG_FILE_COMPRESS=true

# ==================== 安全配置 ====================
# JWT 密钥（用于生成和验证 JWT token）
# 生成方法: openssl rand -base64 32
JWT_SECRET=generate_a_strong_jwt_secret_here

# CORS 允许的源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== Casdoor 配置 ====================
# Casdoor 服务器地址
CASDOOR_ENDPOINT=https://sso.stuhelper.com

# Casdoor 客户端配置（需要在 Casdoor 管理后台创建应用后填入）
CASDOOR_CLIENT_ID=your_client_id_here
CASDOOR_CLIENT_SECRET=your_client_secret_here

# Casdoor 组织和应用名称
CASDOOR_ORGANIZATION=stuhelper
CASDOOR_APPLICATION=stuhelper-main

# Casdoor 回调地址（根据实际部署调整）
CASDOOR_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Token 配置
TOKEN_ACCESS_TTL=900
TOKEN_REFRESH_TTL=604800
TOKEN_COOKIE_SECURE=false
TOKEN_COOKIE_DOMAIN=
