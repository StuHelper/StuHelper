# StuHelper 部署环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# PostgreSQL 配置
POSTGRES_USER=stuhelper
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=stuhelper

# PostgreSQL 连接配置（用于应用程序）
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stuhelper
DB_USER=stuhelper
DB_PASSWORD=change_me_in_production

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # 如果需要密码，取消注释并设置

# ==================== 应用配置 ====================
# 应用运行环境: development, production
APP_ENV=development

# 应用端口
APP_PORT=8080

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ==================== 安全配置 ====================
# JWT 密钥（用于生成和验证 JWT token）
# 生成方法: openssl rand -base64 32
JWT_SECRET=generate_a_strong_jwt_secret_here

# CORS 允许的源（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== StuHelper SSO 配置 ====================
# SSO 服务器地址
SSO_ENDPOINT=https://sso.stuhelper.com

# SSO 客户端配置（需要在 SSO 管理后台创建应用后填入）
SSO_CLIENT_ID=your_client_id_here
SSO_CLIENT_SECRET=your_client_secret_here

# SSO 组织和应用名称
SSO_ORGANIZATION=stuhelper
SSO_APPLICATION=stuhelper-main

# SSO 回调地址（根据实际部署调整）
SSO_CALLBACK_URL=http://localhost:8080/api/auth/callback

# JWT 配置（用于生成和验证访问令牌）
JWT_SIGNING_KEY=generate_a_strong_jwt_signing_key_here
JWT_EXPIRES_IN=7200
