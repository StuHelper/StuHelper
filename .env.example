# StuHelper 环境配置
# 复制为 .env 后运行 make dev-init 自动填充密码
# 或手动填入实际值: cp .env.example .env && vim .env

# ==================== Docker Compose 公共 ====================
STACK_NAME=stuhelper-dev
COMPOSE_PROJECT_NAME=stuhelper-dev
POSTGRES_USER=stuhelper
POSTGRES_PASSWORD=RUN_MAKE_DEV_INIT
POSTGRES_DB=stuhelper
POSTGRES_EXTERNAL_PORT=5432
REDIS_PASSWORD=
REDIS_USERNAME=stuhelper_app
REDIS_EXPORTER_USERNAME=stuhelper_metrics
REDIS_EXTERNAL_PORT=6379

# ==================== 数据库用户（最小权限原则） ====================
STUHELPER_APP_DB_PASSWORD=RUN_MAKE_DEV_INIT
CASDOOR_DB_PASSWORD=RUN_MAKE_DEV_INIT
OPENFGA_DB_PASSWORD=RUN_MAKE_DEV_INIT
# 备份与复制用户密码（make dev-init 自动生成随机值）
STUHELPER_BACKUP_DB_PASSWORD=RUN_MAKE_DEV_INIT
STUHELPER_REPLICATION_DB_PASSWORD=RUN_MAKE_DEV_INIT

# ==================== 数据库配置 ====================
# 混合开发（Go 在宿主机运行）: host = localhost
# 全 Docker 开发 / 生产: host = postgres
DATABASE_URL=postgres://stuhelper_app:REPLACE_WITH_STUHELPER_APP_DB_PASSWORD@localhost:5432/stuhelper?sslmode=disable

# 连接池
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30
DB_MAX_CONN_IDLE_TIME=5
DB_QUERY_TIMEOUT=5

# SSL（生产环境建议 verify-full）
DB_SSL_MODE=disable
POSTGRES_ENABLE_SSL=off
POSTGRES_INTERNAL_SSL_MODE=disable
POSTGRES_PGDATA=/var/lib/postgresql/data
POSTGRES_ARCHIVE_MODE=off
POSTGRES_ARCHIVE_TIMEOUT=15min

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_TLS_ENABLED=false

# ==================== 应用配置 ====================
APP_ENV=development
APP_PORT=8080
MAX_BODY_SIZE=10485760
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout
API_IP_RATE_LIMIT=5000
API_GLOBAL_RATE_LIMIT=50000
HEALTH_CHECK_TIMEOUT=3
LOG_SAMPLING_ENABLED=false
LOG_SAMPLING_INITIAL=100
LOG_SAMPLING_AFTER=100

# ==================== Koishi Console 管理员 ====================
# `bots/koishi/koishi.yml` 启动时会读取该密码；开发环境也必须为非空值。
# 生成命令: openssl rand -base64 18
STUHELPER_CONSOLE_ADMIN_PASSWORD=

# ==================== 机器人内部接口 ====================
# Koishi 调用后端 /api/v1/bot/* 时使用；开发环境可留空，生产必须配置强随机值。
# 后端启动时将该 bootstrap token 写入 bot_service_credentials；请求认证始终走 DB 凭据。
BOT_SERVICE_TOKEN=
# Koishi 插件运行时读取以下两个变量；service token 使用当前已 bootstrap/轮换后的 Koishi 凭据值。
STUHELPER_PLATFORM_BASE_URL=http://localhost:8080
STUHELPER_PLATFORM_SERVICE_TOKEN=
ADMISSION_PUBLIC_BASE_URL=http://join.localhost:3000
# 可选：覆盖 Koishi 群管中心 JSON 数据目录；留空时使用 Koishi baseDir 下的 data/stuhelperGroupCenter。
STUHELPER_GROUP_CENTER_DATA_DIR=
# 新生材料转发仅允许这些 HTTPS host，多个 host 用逗号分隔。
STUHELPER_FRESHMAN_MATERIAL_HOSTS=cdn.example.test

# ==================== 基础设施镜像（可选完整覆盖） ============
# 默认值同时写在 Compose 中；覆盖时必须提供完整 tag@sha256 引用，避免可变标签漂移。
POSTGRES_IMAGE_REF=postgres:18.3-alpine@sha256:54451ecb8ab38c24c3ec123f2fd501303a3a1856a5c66e98cecf2460d5e1e9d7
REDIS_IMAGE_REF=redis:8.6.2-alpine@sha256:c5e375abb885e6b2021c0377879e4890bf76f9065b8922ffc113f2b226b9fc17
MAILPIT_IMAGE_REF=axllent/mailpit:v1.30.1@sha256:3bd7c2f2696deb35a4780d152b404dceec99cb041b942c0877b3b22384714f85
MINIO_IMAGE_REF=minio/minio:RELEASE.2025-02-28T09-55-16Z@sha256:a929054ae025fa7997857cd0e2a2e3029238e31ad89877326dc032f4c1a14259
MINIO_MC_IMAGE_REF=minio/mc:RELEASE.2025-03-12T17-29-24Z@sha256:470f5546b596e16c7816b9c3fa7a78ce4076bb73c2c73f7faeec0c8043923123
GOLANG_IMAGE_REF=golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
NODE_ALPINE_IMAGE_REF=node:24.18.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
NODE_BOOKWORM_IMAGE_REF=node:24.18.0-bookworm@sha256:5711a0d445a1af54af9589066c646df387d1831a608226f4cd694fc59e745059
CASDOOR_IMAGE_REF=casbin/casdoor:3.31.1@sha256:a9c9bca53ccf94a96f3f8b4ca40298dbe00c114ef0100b742d2085b9368a6a0b
OPENFGA_IMAGE_REF=openfga/openfga:v1.8.12@sha256:e2c06000981774a7a02d8aa2292df800ea80a8bc4df61a7ed5f098738b53b1ff

# ==================== 安全配置 ====================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://join.localhost:3000,http://localhost:3001,http://127.0.0.1:3001
TRUSTED_PROXIES=
# HMAC 密钥（>= 32 字符，生产环境必须用强密钥）
# 生成命令: openssl rand -hex 32
HMAC_SECRET=dev_hmac_secret_change_in_production_32ch

# PII 加密密钥（AES-256，支持密钥轮转，所有环境必须配置）
# 生成命令: openssl rand -hex 32
DOC_AES_ACTIVE_KEY_ID=1
DOC_AES_KEYS=1:REPLACE_WITH_OPENSSL_RAND_HEX_32

# Prometheus Metrics（生产环境必须配置密码）
METRICS_USER=prometheus
METRICS_PASSWORD=

# ==================== OpenTelemetry / Observability =========
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stuhelper-backend
OTEL_SERVICE_NAMESPACE=stuhelper
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=0.2
# 可选：匿名前端 vitals / frontend-errors 上报来源白名单。留空时回退到 CORS_ORIGINS。
FRONTEND_METRICS_ALLOWED_ORIGINS=
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB

# ==================== Casdoor Docker 配置 ====================
CASDOOR_EXTERNALPORT=8085
# ==================== Casdoor SSO 配置（Go 后端使用）=========
CASDOOR_ISSUER=http://localhost:8085
CASDOOR_INTERNAL_ADDRESS=casdoor:8000
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
CASDOOR_ADDITIONAL_REDIRECT_URIS=http://localhost:3000/api/v1/auth/callback,http://127.0.0.1:3000/api/v1/auth/callback,http://join.localhost:3000/api/v1/auth/callback
CASDOOR_ORGANIZATION=stuhelper
CASDOOR_ROLES_CLAIM=roles
CASDOOR_BOOTSTRAP_ENABLED=false
CASDOOR_BOOTSTRAP_ENV_FILE=.env.casdoor-bootstrap.local
CASDOOR_ADMIN_CLIENT_ID=stuhelper-admin
CASDOOR_ADMIN_CLIENT_SECRET=
CASDOOR_ADMIN_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
CASDOOR_ADMIN_ADDITIONAL_REDIRECT_URIS=http://localhost:3001/api/v1/auth/callback,http://127.0.0.1:3001/api/v1/auth/callback
CASDOOR_UNIAPP_CLIENT_ID=stuhelper-uniapp
CASDOOR_UNIAPP_CLIENT_SECRET=
CASDOOR_UNIAPP_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
CASDOOR_SMS_PROVIDER_ENABLED=false
CASDOOR_SMS_PROVIDER_NAME=stuhelper-sms
CASDOOR_SMS_PROVIDER_DISPLAY_NAME=StuHelper-SMS
CASDOOR_SMS_PROVIDER_CATEGORY=SMS
CASDOOR_SMS_PROVIDER_TYPE=CustomHTTP
CASDOOR_SMS_PROVIDER_METHOD=POST
CASDOOR_SMS_PROVIDER_TITLE=content
CASDOOR_SMS_PROVIDER_ENDPOINT=http://host.docker.internal:8080/internal/sms/send
CASDOOR_EMAIL_PROVIDER_ENABLED=false
CASDOOR_APP_PROVISIONING_CLIENT_ID=casdoor-admin-app-provisioning
CASDOOR_APP_PROVISIONING_CLIENT_SECRET=
CASDOOR_APP_PROVISIONING_APPLICATION=casdoor-admin-app-provisioning
CASDOOR_USER_PROFILE_CLIENT_ID=casdoor-admin-user-profile
CASDOOR_USER_PROFILE_CLIENT_SECRET=
CASDOOR_USER_PROFILE_APPLICATION=casdoor-admin-user-profile
CASDOOR_INTROSPECTION_CLIENT_ID=casdoor-token-introspection
CASDOOR_INTROSPECTION_CLIENT_SECRET=
CASDOOR_INTROSPECTION_APPLICATION=casdoor-token-introspection
CASDOOR_ROLE_SYNC_CLIENT_ID=casdoor-admin-role-sync
CASDOOR_ROLE_SYNC_CLIENT_SECRET=
CASDOOR_ROLE_SYNC_APPLICATION=casdoor-admin-role-sync
CASDOOR_USER_LOOKUP_CLIENT_ID=casdoor-admin-user-lookup
CASDOOR_USER_LOOKUP_CLIENT_SECRET=
CASDOOR_USER_LOOKUP_APPLICATION=casdoor-admin-user-lookup
CASDOOR_TOKEN_PROBE_SMOKE_CLIENT_ID=casdoor-token-probe-smoke
CASDOOR_TOKEN_PROBE_SMOKE_CLIENT_SECRET=
CASDOOR_TOKEN_PROBE_SMOKE_APPLICATION=casdoor-token-probe-smoke
CASDOOR_TOKEN_PROBE_SMOKE_REDIRECT_URI=http://localhost:3000/open-platform/token-probe/callback

WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001
WEB_VITE_API_URL=/api

# ==================== OpenFGA 配置 ====================
# 运行 make dev-init / server/cmd/fga-setup 后写回实际 Store / Model ID
OPENFGA_API_URL=http://localhost:8081
OPENFGA_HTTP_EXTERNAL_PORT=8081
OPENFGA_GRPC_EXTERNAL_PORT=8082
OPENFGA_PLAYGROUND_EXTERNAL_PORT=3002
OPENFGA_RESOURCE_SMOKE_MODE=host
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# ==================== 对象存储（实名认证照片） =========
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=stuhelper-identity
OBJECT_STORAGE_ACCESS_KEY_ID=stuhelper
OBJECT_STORAGE_SECRET_ACCESS_KEY=RUN_MAKE_DEV_INIT
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PRESIGN_TTL=600
OBJECT_STORAGE_TLS_CA=

# ==================== 腾讯云短信配置 ====================
SMS_ENABLED=false
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_REGION=ap-beijing
# 内部鉴权密钥（Casdoor Custom HTTP SMS Provider 调用时携带）
# 生成命令: openssl rand -hex 16
SMS_INTERNAL_KEY=

# ==================== 邮件配置 ====================
# 学校邮箱 OTP。开发环境默认使用本地 Mailpit；生产推荐 EMAIL_DRIVER=multi。
EMAIL_ENABLED=true
EMAIL_DRIVER=smtp
EMAIL_STUDENT_VERIFICATION_SUBJECT=学生认证验证码
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@stuhelper.local
EMAIL_FROM_NAME=StuHelper 系统邮件
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_STARTTLS=false
# 腾讯云 SES 驱动配置；Secret 只能写入本地/生产 secret env，不要提交。
EMAIL_TENCENT_SECRET_ID=
EMAIL_TENCENT_SECRET_KEY=
EMAIL_TENCENT_REGION=ap-guangzhou
EMAIL_TENCENT_ENDPOINT=ses.tencentcloudapi.com
EMAIL_TENCENT_TEMPLATE_ID=
EMAIL_TENCENT_REPLY_TO=
EMAIL_TENCENT_TEMPLATE_PURPOSE=学校邮箱认证
EMAIL_TENCENT_TEMPLATE_SCHOOL_NAME=北京航空航天大学
EMAIL_TENCENT_TEMPLATE_EXPIRE_MINUTES=5
# Resend 备用驱动；API Key 只能写入本地/生产 secret env，不要提交。
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_ENDPOINT=https://api.resend.com/emails
EMAIL_RESEND_REPLY_TO=

# ==================== 外部学籍数据源（只读） =========
# 当前用于北京航空航天大学学号 + 姓名即时匹配。真实密码写入本地/生产 secret env，不提交到 git。
EXTERNAL_STUDENT_SOURCE_ENABLED=false
EXTERNAL_STUDENT_SOURCE_NAME=buaa-academic-oracle
EXTERNAL_STUDENT_SOURCE_PROVIDER=oracle
EXTERNAL_STUDENT_SOURCE_SCHOOL_CODE=4111010006
EXTERNAL_STUDENT_SOURCE_ORACLE_HOST=
EXTERNAL_STUDENT_SOURCE_ORACLE_PORT=1521
EXTERNAL_STUDENT_SOURCE_ORACLE_SERVICE_NAME=ORCLPDB1
EXTERNAL_STUDENT_SOURCE_ORACLE_USERNAME=
EXTERNAL_STUDENT_SOURCE_ORACLE_PASSWORD=
EXTERNAL_STUDENT_SOURCE_ORACLE_SCHEMA=USR_JWBIZ
EXTERNAL_STUDENT_SOURCE_ORACLE_TABLE=T_XS_JBXX
EXTERNAL_STUDENT_SOURCE_ORACLE_STUDENT_ID_COLUMN=XH
EXTERNAL_STUDENT_SOURCE_ORACLE_STUDENT_NAME_COLUMN=XM
EXTERNAL_STUDENT_SOURCE_ORACLE_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_STUDENT_SOURCE_ORACLE_QUERY_TIMEOUT_SECONDS=3
EXTERNAL_STUDENT_SOURCE_ORACLE_MAX_OPEN_CONNS=4
EXTERNAL_STUDENT_SOURCE_ORACLE_MAX_IDLE_CONNS=1

# ==================== Token 配置 ====================
# Access Token 5 分钟，靠 Refresh 续期
TOKEN_ACCESS_TTL=300
TOKEN_REFRESH_TTL=604800
TOKEN_COOKIE_SECURE=false
TOKEN_COOKIE_DOMAIN=

# ==================== 评课模块限流 ====================
REVIEW_RATE_POST_LIMIT=500
REVIEW_RATE_VOTE_LIMIT=500
REVIEW_RATE_REPORT_LIMIT=500
REVIEW_RATE_REPLY_LIMIT=500
REVIEW_RATE_WRITE_LIMIT=500
REVIEW_RATE_SEARCH_ANON_LIMIT=500
REVIEW_RATE_SEARCH_USER_LIMIT=500
REVIEW_RATE_BATCH_ANON_LIMIT=500
REVIEW_RATE_BATCH_USER_LIMIT=500

# ==================== Open Platform disclosure 限流 / 重放检测 ====================
# 开发环境可留空并回退到 CORS_ORIGINS 的第一个 origin；生产 / prod-parity 必须显式配置。
OPEN_PLATFORM_CONSENT_BASE_URL=
OPEN_PLATFORM_ACCOUNT_BASE_URL=
OPEN_PLATFORM_DISCLOSURE_APP_LIMIT=600
OPEN_PLATFORM_DISCLOSURE_APP_USER_LIMIT=120
OPEN_PLATFORM_DISCLOSURE_ENDPOINT_LIMIT=1200
OPEN_PLATFORM_DISCLOSURE_CONSENT_LIMIT=20
OPEN_PLATFORM_DISCLOSURE_REPLAY_LIMIT=8
OPEN_PLATFORM_DISCLOSURE_WINDOW_SECONDS=60
OPEN_PLATFORM_DISCLOSURE_REPLAY_WINDOW_SECONDS=300
OPEN_PLATFORM_DISCLOSURE_REPLAY_AUDIT_COOLDOWN_SECONDS=600

# 第三方应用审批前 runtime authorization-code token 最小化探针。
# 开发环境默认不强制；生产环境必须配置真实自动化 runner。
OPEN_PLATFORM_TOKEN_PROBE_RUNTIME_REQUIRED=false
# Local command example when you want to enforce the runner during development:
# OPEN_PLATFORM_TOKEN_PROBE_RUNTIME_COMMAND=/home/you/Code/StuHelper/infra/ops/casdoor-runtime-token-probe-runner.mjs
OPEN_PLATFORM_TOKEN_PROBE_RUNTIME_COMMAND=
OPEN_PLATFORM_TOKEN_PROBE_RUNTIME_TIMEOUT_SECONDS=30
# bundled runner only; leave empty unless OPEN_PLATFORM_TOKEN_PROBE_RUNTIME_REQUIRED=true
CASDOOR_TOKEN_PROBE_USERNAME=
CASDOOR_TOKEN_PROBE_PASSWORD=
CASDOOR_TOKEN_PROBE_BROWSER_HEADLESS=true
CASDOOR_TOKEN_PROBE_BROWSER_EXECUTABLE_PATH=
CASDOOR_TOKEN_PROBE_BROWSER_NO_SANDBOX=true
CASDOOR_TOKEN_PROBE_LOGIN_TIMEOUT_SECONDS=30

# ==================== 部署相关 ====================
TAG=latest
BACKEND_EXTERNAL_PORT=8080
WEB_EXTERNAL_PORT=3000
ADMIN_EXTERNAL_PORT=3001
BUILD_TIME=unknown
WEB_VITE_API_URL=
WEB_VITE_SSO_URL=http://localhost:8085
WEB_VITE_WEB_URL=http://localhost:3000
WEB_VITE_API_TIMEOUT_MS=15000
ADMIN_VITE_API_URL=/api/v1
ADMIN_VITE_BASE=/admin/

# ==================== PostgreSQL 备份 / PITR ===========
BACKUP_LOGICAL_RETENTION_DAYS=14
BACKUP_BASE_RETENTION_DAYS=30
WAL_ARCHIVE_RETENTION_DAYS=14

# ==================== MinIO 对象存储（备份用） ====================
# 开发环境默认复用主对象存储端点/凭据；仅在需要独立备份桶/账号时覆盖以下变量
MINIO_ROOT_USER=RUN_MAKE_DEV_INIT
MINIO_ROOT_PASSWORD=RUN_MAKE_DEV_INIT
MINIO_API_EXTERNAL_PORT=9000
MINIO_CONSOLE_EXTERNAL_PORT=9001
BACKUP_OBJECT_STORAGE_ENDPOINT=
BACKUP_OBJECT_STORAGE_BUCKET=
BACKUP_OBJECT_STORAGE_PREFIX=
BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID=
BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY=
BACKUP_OBJECT_STORAGE_TLS_INSECURE=

# 仅用于让开发环境下的 docker compose 能解析 prod profile 服务定义
BACKEND_IMAGE_REF=stuhelper/backend:dev-placeholder
FRONTEND_IMAGE_REF=stuhelper/frontend:dev-placeholder
ADMIN_IMAGE_REF=stuhelper/admin:dev-placeholder

