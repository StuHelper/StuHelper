# StuHelper 环境配置
# 复制为 .env 后运行 make dev-init 自动填充密码
# 或手动填入实际值: cp .env.example .env && vim .env

# ==================== Docker Compose 公共 ====================
STACK_NAME=stuhelper-dev
POSTGRES_USER=stuhelper
POSTGRES_PASSWORD=RUN_MAKE_DEV_INIT
POSTGRES_DB=stuhelper
REDIS_PASSWORD=
REDIS_USERNAME=stuhelper_app
REDIS_EXPORTER_USERNAME=stuhelper_metrics

# ==================== 数据库用户（最小权限原则） ====================
STUHELPER_APP_DB_PASSWORD=RUN_MAKE_DEV_INIT
ZITADEL_DB_PASSWORD=RUN_MAKE_DEV_INIT
OPENFGA_DB_PASSWORD=RUN_MAKE_DEV_INIT
# 备份与复制用户密码（make dev-init 自动生成随机值）
STUHELPER_BACKUP_DB_PASSWORD=RUN_MAKE_DEV_INIT
STUHELPER_REPLICATION_DB_PASSWORD=RUN_MAKE_DEV_INIT

# ==================== 数据库配置 ====================
# 混合开发（Go 在宿主机运行）: host = localhost
# 全 Docker 开发 / 生产: host = postgres
DATABASE_URL=postgres://stuhelper_app:REPLACE_WITH_STUHELPER_APP_DB_PASSWORD@localhost:5432/stuhelper?sslmode=disable

# 连接池
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30
DB_MAX_CONN_IDLE_TIME=5
DB_QUERY_TIMEOUT=5

# SSL（生产环境建议 verify-full）
DB_SSL_MODE=disable
POSTGRES_ENABLE_SSL=off
POSTGRES_INTERNAL_SSL_MODE=disable
POSTGRES_PGDATA=/var/lib/postgresql/data
POSTGRES_ARCHIVE_MODE=off
POSTGRES_ARCHIVE_TIMEOUT=60s

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_TLS_ENABLED=false

# ==================== 应用配置 ====================
APP_ENV=development
APP_PORT=8080
MAX_BODY_SIZE=10485760
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout
API_IP_RATE_LIMIT=100
API_GLOBAL_RATE_LIMIT=10000
HEALTH_CHECK_TIMEOUT=3
LOG_SAMPLING_ENABLED=false
LOG_SAMPLING_INITIAL=100
LOG_SAMPLING_AFTER=100

# ==================== Koishi Console 管理员 ====================
# `bots/koishi/koishi.yml` 启动时会读取该密码；开发环境也必须为非空值。
# 生成命令: openssl rand -base64 18
STUHELPER_CONSOLE_ADMIN_PASSWORD=

# ==================== 机器人内部接口 ====================
# Koishi 调用后端 /api/v1/bot/* 时使用；开发环境可留空，生产必须配置强随机值。
BOT_SERVICE_TOKEN=
# Koishi 插件运行时实际读取以下两个变量；service token 应与 BOT_SERVICE_TOKEN 使用同一个值。
STUHELPER_PLATFORM_BASE_URL=http://localhost:8080
STUHELPER_PLATFORM_SERVICE_TOKEN=

# ==================== 镜像版本（可选覆盖） ====================
POSTGRES_VERSION=18.3-alpine
REDIS_VERSION=8.6.2-alpine

# ==================== 安全配置 ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUSTED_PROXIES=
# HMAC 密钥（>= 32 字符，生产环境必须用强密钥）
# 生成命令: openssl rand -hex 32
HMAC_SECRET=dev_hmac_secret_change_in_production_32ch

# PII 加密密钥（AES-256，支持密钥轮转，所有环境必须配置）
# 生成命令: openssl rand -hex 32
DOC_AES_ACTIVE_KEY_ID=1
DOC_AES_KEYS=1:REPLACE_WITH_OPENSSL_RAND_HEX_32

# Prometheus Metrics（生产环境必须配置密码）
METRICS_USER=prometheus
METRICS_PASSWORD=

# ==================== OpenTelemetry / Observability =========
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stuhelper-backend
OTEL_SERVICE_NAMESPACE=stuhelper
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=0.2
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB

# ==================== Zitadel Docker 配置 ====================
# 外部访问端口（Traefik 对外端口，与 TRAEFIK_HTTP_PORT 保持一致）
ZITADEL_EXTERNALPORT=8085
ZITADEL_DOMAIN=localhost
ZITADEL_PUBLIC_SCHEME=http
ZITADEL_EXTERNALSECURE=false
ZITADEL_VERSION=v4.13.0
# Masterkey（必须 32 字符，生产环境必须替换）
# 生成命令: openssl rand -base64 24 | head -c 32
ZITADEL_MASTERKEY=REPLACE_WITH_ZITADEL_MASTERKEY_32_CHARS
ZITADEL_ADMIN_PASSWORD=REPLACE_WITH_ZITADEL_ADMIN_PASSWORD
LOGIN_CLIENT_PAT_EXPIRATION=REPLACE_WITH_LOGIN_CLIENT_PAT_EXPIRATION_ISO8601
ZITADEL_ACCESS_LOG_STDOUT_ENABLED=true
# Traefik Edge Proxy
TRAEFIK_LOG_LEVEL=WARN
TRAEFIK_ACCESSLOG_ENABLED=false
# 绑定地址：开发用 127.0.0.1，生产用 0.0.0.0
TRAEFIK_BIND_IP=127.0.0.1
TRAEFIK_HTTP_PORT=8085
TRAEFIK_HTTPS_PORT=443
# TLS / ACME（Let's Encrypt）
# 生产环境设置邮箱即可启用 ACME 自动证书
TRAEFIK_ACME_EMAIL=
# HTTP → HTTPS 重定向（生产启用时设为 websecure）
TRAEFIK_TLS_REDIRECT_TARGET=
TRAEFIK_TLS_REDIRECT_PERMANENT=false

# ==================== Casdoor SSO 配置（Go 后端使用）=========
CASDOOR_ISSUER=http://localhost
CASDOOR_INTERNAL_ADDRESS=host.docker.internal:8085
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
CASDOOR_ORGANIZATION=stuhelper
CASDOOR_ROLES_CLAIM=roles
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# ==================== OpenFGA 配置 ====================
# 运行 make dev-init / server/cmd/fga-setup 后写回实际 Store / Model ID
OPENFGA_API_URL=http://localhost:8081
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# ==================== 对象存储（实名认证照片） =========
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=stuhelper-identity
OBJECT_STORAGE_ACCESS_KEY_ID=stuhelper
OBJECT_STORAGE_SECRET_ACCESS_KEY=RUN_MAKE_DEV_INIT
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PRESIGN_TTL=600

# ==================== 腾讯云短信配置 ====================
SMS_ENABLED=false
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_REGION=ap-beijing
# 内部鉴权密钥（Zitadel Action 调用时携带）
# 生成命令: openssl rand -hex 16
SMS_INTERNAL_KEY=
# 内部 SMS HTTP 端口（仅监听 127.0.0.1，供 Zitadel Action 调用）
SMS_INTERNAL_PORT=9090

# ==================== Token 配置 ====================
# Access Token 5 分钟，靠 Refresh 续期
TOKEN_ACCESS_TTL=300
TOKEN_REFRESH_TTL=604800
TOKEN_COOKIE_SECURE=false
TOKEN_COOKIE_DOMAIN=

# ==================== 评课模块限流 ====================
REVIEW_RATE_POST_LIMIT=5
REVIEW_RATE_VOTE_LIMIT=30
REVIEW_RATE_REPORT_LIMIT=10
REVIEW_RATE_REPLY_LIMIT=10
REVIEW_RATE_WRITE_LIMIT=10

# ==================== 部署相关 ====================
TAG=latest
ADMIN_EXTERNAL_PORT=3001
BUILD_TIME=unknown
WEB_VITE_API_URL=
WEB_VITE_SSO_URL=http://localhost
WEB_VITE_API_TIMEOUT_MS=15000
ADMIN_VITE_API_URL=/api/v1
ADMIN_VITE_BASE=/admin/

# ==================== PostgreSQL 备份 / PITR ===========
BACKUP_LOGICAL_RETENTION_DAYS=14
BACKUP_BASE_RETENTION_DAYS=30
WAL_ARCHIVE_RETENTION_DAYS=14

# ==================== MinIO 对象存储（备份用） ====================
# 开发环境默认复用主对象存储端点/凭据；仅在需要独立备份桶/账号时覆盖以下变量
MINIO_ROOT_USER=RUN_MAKE_DEV_INIT
MINIO_ROOT_PASSWORD=RUN_MAKE_DEV_INIT
BACKUP_OBJECT_STORAGE_ENDPOINT=
BACKUP_OBJECT_STORAGE_BUCKET=
BACKUP_OBJECT_STORAGE_PREFIX=
BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID=
BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY=
BACKUP_OBJECT_STORAGE_TLS_INSECURE=

# 仅用于让开发环境下的 docker compose 能解析 prod profile 服务定义
BACKEND_IMAGE_REF=stuhelper/backend:dev-placeholder
FRONTEND_IMAGE_REF=stuhelper/frontend:dev-placeholder
ADMIN_IMAGE_REF=stuhelper/admin:dev-placeholder

# ==================== 可观测性栈版本/端口 ====================
GRAFANA_ALLOY_VERSION=v1.10.2
PROMETHEUS_VERSION=v3.5.0
ALERTMANAGER_VERSION=v0.28.1
LOKI_VERSION=3.5.5
TEMPO_VERSION=2.8.2
GRAFANA_VERSION=12.1.1
NODE_EXPORTER_VERSION=v1.9.1
CADVISOR_VERSION=v0.52.1
POSTGRES_EXPORTER_VERSION=v0.17.1
REDIS_EXPORTER_VERSION=v1.76.0
BLACKBOX_EXPORTER_VERSION=v0.27.0

ALLOY_HTTP_PORT=12345
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
GRAFANA_PORT=3003
CADVISOR_PORT=8088
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
BLACKBOX_EXPORTER_PORT=9115

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeBeforeProduction
GRAFANA_ROOT_URL=http://localhost:3003
ALERTMANAGER_WEBHOOK_URL=
ALLOW_LOCAL_ALERT_SINK=false
