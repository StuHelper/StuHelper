CASDOOR_USER_PROFILE_APPLICATION=casdoor-admin-user-profile
CASDOOR_USER_PROFILE_CERTIFICATE=
# 留空时从 OIDC discovery 读取 introspection endpoint。
CASDOOR_INTROSPECTION_ENDPOINT=
CASDOOR_INTROSPECTION_CLIENT_ID=casdoor-token-introspection
CASDOOR_INTROSPECTION_CLIENT_SECRET=REPLACE_WITH_CASDOOR_INTROSPECTION_CLIENT_SECRET
CASDOOR_INTROSPECTION_APPLICATION=casdoor-token-introspection
STUHELPER_ADMIN_MFA_BOOTSTRAP_USERS=REPLACE_WITH_PRIVILEGED_ADMIN_USERNAMES
CASDOOR_USER_LOOKUP_CLIENT_ID=casdoor-admin-user-lookup
CASDOOR_USER_LOOKUP_CLIENT_SECRET=REPLACE_WITH_CASDOOR_USER_LOOKUP_CLIENT_SECRET
CASDOOR_USER_LOOKUP_APPLICATION=casdoor-admin-user-lookup
CASDOOR_USER_LOOKUP_CERTIFICATE=
