WEB_VITE_SSO_URL=https://sso.stuhelper.com
WEB_VITE_WEB_URL=https://stuhelper.com
ADMIN_VITE_API_URL=/api/v1
ADMIN_VITE_BASE=/admin/
BACKEND_EXTERNAL_PORT=18080
WEB_EXTERNAL_PORT=18000
ADMIN_EXTERNAL_PORT=18001

OPENFGA_API_URL=http://openfga:8080
OPENFGA_RESOURCE_SMOKE_MODE=container
# 生产样例必须留空：OpenFGA bootstrap 会创建 store/model，并把真实 ID 写入 generated env。
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

OBJECT_STORAGE_ENDPOINT=REPLACE_WITH_OBJECT_STORAGE_ENDPOINT
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=stuhelper-identity
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_OBJECT_STORAGE_ACCESS_KEY_ID
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_OBJECT_STORAGE_SECRET_ACCESS_KEY
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_TTL=600
# 留空时使用系统 CA；私有 CA 可挂载到 /object-storage-tls 后填写容器内路径。
OBJECT_STORAGE_TLS_CA=
# 私有 CA 的宿主机只读源文件；部署脚本只把证书复制到独立的应用挂载目录。
OBJECT_STORAGE_TLS_CA_HOST_PATH=

BACKUP_OBJECT_STORAGE_ENDPOINT=REPLACE_WITH_BACKUP_OBJECT_STORAGE_ENDPOINT
BACKUP_OBJECT_STORAGE_BUCKET=stuhelper-postgres-backup
# 必须以实时 PostgreSQL system_identifier 结尾，避免不同集群的 WAL 进入同一恢复命名空间。
BACKUP_OBJECT_STORAGE_PREFIX=postgres/REPLACE_WITH_POSTGRES_SYSTEM_IDENTIFIER
BACKUP_OBJECT_STORAGE_PROVIDER=Other
BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID
BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY
# 仅当备份目标处于独立故障域、生产主机完全丢失后仍可访问时设为 true。
BACKUP_OBJECT_STORAGE_OFF_HOST_CONFIRMED=false
# 逗号或空格分隔的生产主机公网/NAT/LB IP 或 CIDR；确认不存在额外身份时显式填 none。
BACKUP_OBJECT_STORAGE_LOCAL_IDENTITY_CIDRS=
# 默认 none。腾讯云同地域 COS 的官方 regional endpoint 解析为 provider-private VIP 时，
# 仅在 provider/region/bucket/HTTPS/public-CA/virtual-hosted 校验全部满足后填 tencent-cos。
BACKUP_OBJECT_STORAGE_PROVIDER_PRIVATE_ENDPOINT=none
BACKUP_OBJECT_STORAGE_REGION=us-east-1
BACKUP_OBJECT_STORAGE_FORCE_PATH_STYLE=false
BACKUP_OBJECT_STORAGE_TLS_CA=
BACKUP_OBJECT_STORAGE_TLS_INSECURE=false
BACKUP_OBJECT_STORAGE_DOCKER_NETWORK=
BACKUP_LOGICAL_RETENTION_DAYS=14
BACKUP_BASE_RETENTION_DAYS=30
WAL_ARCHIVE_RETENTION_DAYS=14

METRICS_USER=prometheus
METRICS_PASSWORD=REPLACE_WITH_METRICS_PASSWORD
OTEL_ENABLED=true
OTEL_SERVICE_NAME=stuhelper-backend
OTEL_SERVICE_NAMESPACE=stuhelper
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_INSECURE=true
ALLOY_DOCKER_LOG_MAX_AGE=1h
ALLOY_DOCKER_STREAM_TIMEOUT=24h
FRONTEND_METRICS_ALLOWED_ORIGINS=https://stuhelper.com,https://join.stuhelper.com
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB
GRAFANA_ROOT_URL=REPLACE_WITH_GRAFANA_ROOT_URL
ALERTMANAGER_WEBHOOK_URL=REPLACE_WITH_ALERTMANAGER_WEBHOOK_URL
ALLOW_LOCAL_ALERT_SINK=false

# 基础设施与运维镜像必须保持完整 tag@sha256；init-prod-env 仅替换仓库已知的旧默认值。
POSTGRES_IMAGE_REF=cgr.dev/chainguard/postgres:latest@sha256:dc2f04037c1044a22af76cee4de70b9111885b17c561b939d7ed70103d100759
REDIS_IMAGE_REF=redis:8.8.1-alpine@sha256:8096655e437712b07503796fb64d81359256cfcff0ab29d95a7da72863786efb
RCLONE_IMAGE_REF=rclone/rclone:beta@sha256:f52965eba611ba8984117638b2a0539dcce170731937f93fbace66897d102698
GOLANG_IMAGE_REF=cgr.dev/chainguard/go:latest@sha256:b116b5f2d3f5e7556b66252f9ee7ef9988b84c2139c89d824efcebd6cadbf436
OPENFGA_IMAGE_REF=openfga/openfga:v1.18.1@sha256:efde89d24487da1a8bc37d85b61341f1fb7024943a1ded65f4b7d51a75666688
DOCKER_SOCKET_PROXY_IMAGE_REF=ghcr.io/tecnativa/docker-socket-proxy:latest@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459
