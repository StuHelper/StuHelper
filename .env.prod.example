SSO_PUBLIC_BASE_URL=https://sso.stuhelper.com
SSO_PUBLIC_SMOKE_EXPECTED_ISSUER=https://sso.stuhelper.com
SSO_PUBLIC_SMOKE_CLIENT_ID=stuhelper-web
SSO_PUBLIC_SMOKE_APPLICATION_ID=admin/stuhelper-web
