SMS_SIGN_NAME=REPLACE_WITH_SMS_SIGN_NAME
SMS_TEMPLATE_ID=REPLACE_WITH_SMS_TEMPLATE_ID
SMS_REGION=ap-beijing
SMS_INTERNAL_KEY=REPLACE_WITH_SMS_INTERNAL_KEY

EMAIL_ENABLED=true
EMAIL_DRIVER=multi
# 可选 JSON 默认策略；留空使用内置 priority/failover 顺序。
EMAIL_PROVIDER_POLICY=
EMAIL_STUDENT_VERIFICATION_SUBJECT=学生认证验证码
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
