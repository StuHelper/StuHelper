# StuHelper 生产环境配置样板

STACK_NAME=stuhelper-prod
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

DATABASE_URL=postgres://stuhelper_app:REPLACE_WITH_STUHELPER_APP_DB_PASSWORD@postgres:5432/stuhelper?sslmode=verify-full&sslrootcert=/tls/ca.crt
BACKUP_DATABASE_URL=postgres://stuhelper_backup:REPLACE_WITH_STUHELPER_BACKUP_DB_PASSWORD@postgres:5432/stuhelper?sslmode=verify-full&sslrootcert=/tls/ca.crt
REPLICATION_DATABASE_URL=postgres://stuhelper_replication:REPLACE_WITH_STUHELPER_REPLICATION_DB_PASSWORD@postgres:5432/stuhelper?sslmode=verify-full&sslrootcert=/tls/ca.crt
DB_SSL_MODE=verify-full
DB_SSL_ROOT_CERT=/tls/ca.crt
POSTGRES_ENABLE_SSL=on
POSTGRES_INTERNAL_SSL_MODE=verify-full
POSTGRES_ARCHIVE_TIMEOUT=15min
EXTERNAL_POSTGRES_ENABLED=false
EXTERNAL_POSTGRES_ALLOW_PLAINTEXT=false
EXTERNAL_DATASTORE_NETWORK=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=stuhelper_app
REDIS_DB=0
REDIS_TLS_ENABLED=true
REDIS_TLS_CA=/tls/ca.crt

STUHELPER_CONSOLE_ADMIN_PASSWORD=REPLACE_WITH_CONSOLE_ADMIN_PASSWORD
# 生成期占位：不是生产凭据。init-prod-env 只复制该占位符；prod-deploy 前必须从真实 bot service credential 或 secret backend 注入。
BOT_SERVICE_TOKEN=REPLACE_WITH_BOT_SERVICE_TOKEN_BOOTSTRAP
STUHELPER_PLATFORM_BASE_URL=https://stuhelper.com
STUHELPER_PLATFORM_SERVICE_TOKEN=REPLACE_WITH_KOISHI_SERVICE_TOKEN
