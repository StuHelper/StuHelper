    "@vueuse/motion": "^2.2.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.2",
    "gsap": "^3.12.0",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^2.2.0",
    "pinyin-pro": "^3.28.0",
    "radix-vue": "^1.9.0",
    "vue": "^3.5.13",
