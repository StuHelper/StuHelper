{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "StuHelper",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/course/index",
      "style": {
        "navigationBarTitleText": "Courses"
      }
    },
    {
      "path": "pages/course/detail",
      "style": {
        "navigationBarTitleText": "Course Details"
      }
    },
    {
      "path": "pages/review/index",
      "style": {
        "navigationBarTitleText": "Review Square"
      }
    },
    {
      "path": "pages/review/post",
      "style": {
        "navigationBarTitleText": "Post Review"
      }
    },
    {
      "path": "pages/teacher/profile",
      "style": {
        "navigationBarTitleText": "Teacher Profile"
      }
    },
    {
      "path": "pages/user/index",
      "style": {
        "navigationBarTitleText": "Profile"
      }
    },
    {
      "path": "pages/user/notifications",
      "style": {
        "navigationBarTitleText": "Notifications"
      }
    },
    {
      "path": "pages/user/reviews",
      "style": {
        "navigationBarTitleText": "My Reviews"
      }
    },
    {
      "path": "pages/user/votes",
      "style": {
        "navigationBarTitleText": "My Votes"
      }
    },
    {
      "path": "pages/user/favorites",
      "style": {
        "navigationBarTitleText": "My Favorites"
      }
    },
    {
      "path": "pages/auth/login",
      "style": {
        "navigationBarTitleText": "Sign In",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/auth/callback",
      "style": {
        "navigationBarTitleText": "SSO Callback",
        "navigationStyle": "custom"
      }
    }
  ],
  "tabBar": {
    "color": "#8B8B8B",
    "selectedColor": "#6366F1",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/course/index",
        "text": "课程",
        "iconPath": "static/tabbar/course.png",
        "selectedIconPath": "static/tabbar/course-active.png"
      },
      {
        "pagePath": "pages/review/index",
        "text": "评课",
        "iconPath": "static/tabbar/review.png",
        "selectedIconPath": "static/tabbar/review-active.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "StuHelper",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F9FA"
  }
}
