      "import": "./dist/types/business/index.js"
    },
    "./course": {
      "source": "./src/course.ts",
      "types": "./dist/course.d.ts",
      "import": "./dist/course.js"
    },
    "./review": {
      "source": "./src/review.ts",
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js"
    },
    "./draft": {
      "source": "./src/draft.ts",
      "types": "./dist/draft.d.ts",
      "import": "./dist/draft.js"
