ARG ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.13.0

FROM ${ZITADEL_IMAGE} AS zitadel

FROM alpine:3.22

RUN apk add --no-cache ca-certificates     && addgroup -S zitadel -g 10001     && adduser -S -D -H -u 10001 -G zitadel zitadel     && mkdir -p /zitadel/bootstrap     && touch /zitadel/bootstrap/.keep

COPY --from=zitadel /app/zitadel /app/zitadel
COPY infra/zitadel/init.sh /zitadel/init.sh

RUN chmod +x /app/zitadel /zitadel/init.sh     && chown -R 10001:10001 /app /zitadel

USER 10001:10001

ENTRYPOINT ["/bin/sh", "/zitadel/init.sh"]
