        "systemBindDN": "uid=stuhelper-reader,ou=system,dc=example,dc=edu",
        "systemBindPasswordEnv": "SCHOOL_LDAP_READER_PASSWORD",
        "uidAttribute": "uid",
        "subjectAttribute": "uid",
        "accountLockedAttribute": "accountLocked",
        "accountDisabledAttribute": "accountDisabled",
        "studentMarkerAttribute": "eduPersonAffiliation",
        "studentMarkerValues": ["student"]
      }
    },
    {
      "key": "school.roster.full",
      "schoolCode": "0000000001",
      "type": "roster_snapshot_upload",
      "adapterID": "school_oracle_roster",
      "adapterVersion": "1",
      "upstreamProtocol": "oracle_tls",
      "targetHost": "oracle.internal.example.edu",
      "targetPort": 2484,
      "tlsServerName": "oracle.internal.example.edu",
      "timeoutMilliseconds": 120000,
      "oracleRoster": {
        "serviceName": "REPLACE_WITH_SERVICE_NAME",
        "usernameEnv": "SCHOOL_ORACLE_EXISTING_USERNAME",
        "passwordEnv": "SCHOOL_ORACLE_EXISTING_PASSWORD",
        "caFile": "/run/secrets/school-oracle-ca.crt",
        "allowedDialTargets": [
          "oracle.internal.example.edu:2484",
          "oracle-rac-2.internal.example.edu:2484"
        ],
        "expectedUsername": "REPLACE_WITH_EXISTING_ORACLE_USERNAME",
        "schema": "REPLACE_WITH_APPROVED_OWNER",
        "table": "REPLACE_WITH_APPROVED_OBJECT",
        "activeFilterColumn": "SFZX",
