{
  "nodeID": "00000000-0000-4000-8000-000000000001",
  "softwareVersion": "dev",
  "centralBaseURL": "https://connector-gateway.example.edu:9444",
  "clientCertificateFile": "/run/secrets/campus-connector-client.crt",
  "clientPrivateKeyFile": "/run/secrets/campus-connector-client.key",
  "centralCAFile": "/run/secrets/campus-connector-central-ca.crt",
  "signingKeyID": "replace-with-enrolled-ed25519-key-id",
