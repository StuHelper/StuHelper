      "targetPort": 636,
      "tlsServerName": "ldap.internal.example.edu",
      "timeoutMilliseconds": 5000,
      "ldap": {
        "caFile": "/run/secrets/school-ldap-ca.crt",
        "userDNTemplate": "uid={student_id},ou=people,dc=example,dc=edu",
