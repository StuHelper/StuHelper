model
  schema 1.1

# ============================================
# StuHelper 生态 - OpenFGA 授权模型
# ============================================
#
# 关系链：ecosystem → school → course → review
# 权限继承：super_admin → effective_admin → volunteer → author
#
# OpenFGA DSL 限制：只支持单层 `x from y`，不支持 `a.b` 链式 TTU。
# 解决方法：每层通过中间 relation 把上层的 school 投影下来。
#
# 使用方法：
#   openfga model write --store-id $STORE_ID --file model.fga
# ============================================

# 用户类型（Zitadel 用户 ID）
type user

# ── 生态 ──

type ecosystem
  relations
    define super_admin: [user]

# ── 学校 ──

type school
  relations
    define parent: [ecosystem]
    define admin: [user]
    define reviewer: [user]
    define volunteer: [user]
    # 有效管理员 = 直接管理员 + 生态超管（单层 TTU: super_admin from parent）
    define effective_admin: admin or super_admin from parent

# ── 课程 ──

type course
  relations
    define school: [school]
    define owner: [user]
    define teaching_assistant: [user]
    # 单层 TTU: effective_admin from school ✅
    define can_edit: owner or teaching_assistant or effective_admin from school
    define can_view: owner or teaching_assistant or effective_admin from school

# ── 评课 ──
#
# 关键设计：review 不能直接写 `volunteer from course.school`（链式 TTU 不合法）。
# 解决方案：review 上增加 `school` 中间 relation，创建评课时同时写入：
#   review:100 | course | course:42
#   review:100 | school | school:buaa    ← 冗余但必要
#   review:100 | author | user:C

type review
  relations
    define course: [course]
    define school: [school]
    define author: [user]
    # 编辑：仅作者
    define can_edit: author
    # 删除：作者 + 志愿者(从 school) + 有效管理员(从 school)
    define can_delete: author or volunteer from school or effective_admin from school
    # 隐藏：志愿者 + 有效管理员
    define can_hide: volunteer from school or effective_admin from school
    # 查看作者实名信息：仅有效管理员（志愿者不行）
    define can_view_author_identity: effective_admin from school

# ── 举报 ──
#
# 同理：report 也需要 school 中间 relation，避免三层链式。
# 创建举报时写入：
#   report:200 | review  | review:100
#   report:200 | school  | school:buaa   ← 冗余但必要
#   report:200 | reporter| user:E

type report
  relations
    define review: [review]
    define school: [school]
    define reporter: [user]
    # 能处理举报：志愿者 + 有效管理员
    define can_process: volunteer from school or effective_admin from school

# ── 用户档案（控制实名信息可见性）──

type user_profile
  relations
    define owner: [user]
    define school: [school]
    define can_view_own: owner
    define can_view_identity: effective_admin from school
    define can_review_verification: effective_admin from school
